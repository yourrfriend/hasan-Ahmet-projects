# /yayinla komutunun ayarları. Bu dosyayı .claude/yayin.env olarak kopyala ve doldur (yayin.env git'e girmez).
# SSH hedefi: kullanıcı@adres ya da ~/.ssh/config'teki ad. Claude Code doğrudan VPS'te çalışıyorsa: yerel
VPS=root@SUNUCU_IP
# Depo VPS'te nerede duracak
DEPO=/opt/src/hasan-Ahmet-projects
# Oyunlar AD.ALAN_KOK adresinde yayınlanır (DNS: *.games.munupixi.com → VPS IP)
ALAN_KOK=games.munupixi.com
# /yayinla tek başına yazılınca kurulan sürüm (kasaba.games.munupixi.com)
CANLI_SURUM=main
